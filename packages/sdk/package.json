{
  "name": "@hyacine/sdk",
  "version": "0.1.1",
  "description": "Hyacine TS SDK: Astro SSG Live Collections Loader + AI Services & Client",
  "homepage": "https://github.com/zkz098/hyacine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkz098/hyacine.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./astro": {
      "types": "./dist/astro/index.d.mts",
      "default": "./dist/astro/index.mjs"
    },
    "./ai": {
      "types": "./dist/ai/index.d.mts",
      "default": "./dist/ai/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/astro/index.ts src/ai/index.ts -d dist --target node24 --format esm --dts --clean",
    "typecheck": "oxlint -A all --type-aware --type-check .",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hyacine/contract": "workspace:*",
    "gray-matter": "^4.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
