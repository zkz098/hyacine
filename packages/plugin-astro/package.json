{
  "name": "@hyacine/plugin-astro",
  "version": "0.2.2",
  "description": "Hyacine Astro 插件集成：双模注入（声明式 <HyacineOutlet> + 零侵入 AST 注入）与 Vite 虚拟模块分发",
  "homepage": "https://github.com/zkz098/hyacine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkz098/hyacine.git",
    "directory": "packages/plugin-astro"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./components/HyacineOutlet.astro": "./src/components/HyacineOutlet.astro"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts -d dist --target node24 --format esm --dts --clean",
    "typecheck": "oxlint -A all --type-aware --type-check .",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/compiler": "^3.0.1",
    "@hyacine/contract": "workspace:*",
    "@hyacine/plugin-core": "workspace:*",
    "es-toolkit": "^1.39.0",
    "jiti": "^2.4.2",
    "magic-string": "^0.30.17"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "astro": "^5.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
