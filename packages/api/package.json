{
  "name": "@hyacine/api",
  "version": "0.1.0",
  "private": true,
  "description": "hyacine API — Hono on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "typecheck": "oxlint -A all --type-aware --type-check .",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev --port 8787 --local",
    "smoke": "node scripts/smoke.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpx wrangler d1 migrations apply DB --remote && pnpx wrangler deploy"
  },
  "dependencies": {
    "@hyacine/contract": "workspace:*",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
