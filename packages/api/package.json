{
  "name": "@hyacine/api",
  "version": "0.1.0",
  "private": true,
  "description": "hyacine API — Hono on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev --port 8787 --local",
    "smoke": "node scripts/smoke.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "aws4fetch": "^1.0.19",
    "hono": "^4.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250821.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.30.0"
  }
}
