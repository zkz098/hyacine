{
  "name": "@hyacine/cli",
  "version": "0.1.1",
  "description": "hyacine CLI — local + remote modes",
  "homepage": "https://github.com/zkz098/hyacine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkz098/hyacine.git",
    "directory": "packages/cli"
  },
  "bin": {
    "hyc": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "oxlint -A all --type-aware --type-check .",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@hyacine/contract": "workspace:*",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "jiti": "^2.7.0",
    "tar": "^7.5.22",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
