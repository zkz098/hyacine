{
  "name": "@hyacine/contract",
  "version": "0.1.1",
  "description": "hyacine 三端契约：zod schemas + 推导类型 + typed client（唯一真相）",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts -d dist --target node24 --format esm --dts --clean",
    "typecheck": "oxlint -A all --type-aware --type-check .",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pinyin-pro": "^3.29.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
