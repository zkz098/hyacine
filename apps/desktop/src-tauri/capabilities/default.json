{
  "$schema": "https://schema.tauri.app/config/2/capabilities/default.json",
  "identifier": "default",
  "description": "default capabilities for hyacine desktop (fs scope open to any user-selected folder so offline local blog editing works anywhere on disk)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "dialog:default",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "git", "cmd": "git", "args": true },
        { "name": "pnpm", "cmd": "pnpm", "args": true },
        { "name": "npm", "cmd": "npm", "args": true },
        { "name": "bun", "cmd": "bun", "args": true }
      ]
    }
  ]
}
