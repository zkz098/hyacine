{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hyacine",
  "version": "0.1.0",
  "identifier": "com.hyacine.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @hyacine/console dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "pnpm --filter @hyacine/console build",
    "frontendDist": "../../console/dist"
  },
  "app": {
    "windows": [
      {
        "title": "hyacine",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  },
  "plugins": {}
}
