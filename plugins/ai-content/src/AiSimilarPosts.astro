---
import { resolvePostSimilar } from "./shared";

interface Props {
  hyacineArticle?: Record<string, unknown> | null;
  /** 总开关（来自插件配置，false 时组件短路不渲染） */
  enable?: boolean;
  limit?: number;
  minSimilarity?: number;
  title?: string;
  /** 页面通过 HyacineOutlet extraProps 传入的文章标识 */
  postId?: string;
  apiUrl?: string;
  token?: string;
}

const props = Astro.props as Props;
const enabled = props.enable !== false;
const limit = Math.max(1, Math.min(10, typeof props.limit === "number" ? props.limit : 3));
const rawMin = typeof props.minSimilarity === "number" ? props.minSimilarity : 0.4;
const minSimilarity = Math.min(1, Math.max(0, rawMin > 1 ? rawMin / 100 : rawMin));
const title =
  typeof props.title === "string" && props.title ? props.title : "AI 推荐 · 相近文章";

const similarPosts = enabled
  ? await resolvePostSimilar({
      data: props.hyacineArticle,
      postId: props.postId,
      enable: true,
      limit,
      minSimilarity,
      apiUrl: props.apiUrl,
      token: props.token,
    })
  : [];
---

{
  similarPosts.length > 0 && (
    <section class="ai-similar-posts" aria-label="AI 相近文章推荐">
      <div class="ai-similar-posts__title">
        <span class="ai-similar-posts__title-icon" aria-hidden="true">🤖</span>
        <span>{title}</span>
      </div>

      <ul class="ai-similar-posts__list">
        {similarPosts.map((item) => (
          <li class="ai-similar-posts__item">
            <a href={`/posts/${item.slug}/`}>
              <span class="ai-similar-posts__name">{item.title}</span>
              <span class="ai-similar-posts__score">
                相似度 {Math.round(item.score * 100)}%
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .ai-similar-posts {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding: 0.875rem 1rem;
    border-radius: 0.625rem;
    background: var(--grey-2, rgba(127, 127, 127, 0.08));
    border: 1px solid var(--grey-3, rgba(127, 127, 127, 0.18));
  }

  .ai-similar-posts__title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--primary-color, var(--color-blue, #3b82f6));
    font-weight: 600;
    margin-bottom: 0.625rem;
  }

  .ai-similar-posts__title-icon {
    font-size: 1em;
    line-height: 1;
  }

  .ai-similar-posts__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-similar-posts__item + .ai-similar-posts__item {
    margin-top: 0.375rem;
  }

  .ai-similar-posts__item a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-color, #333);
    border-radius: 0.375rem;
    padding: 0.375rem 0.5rem;
    transition: background-color 0.25s ease;
  }

  .ai-similar-posts__item a:hover {
    background-color: var(--color-red-a1, rgba(239, 68, 68, 0.08));
  }

  .ai-similar-posts__name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ai-similar-posts__score {
    font-size: 0.75rem;
    color: var(--grey-5, #999);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>