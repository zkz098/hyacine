{
  "name": "hyacine",
  "version": "0.1.0",
  "private": true,
  "description": "astro-blog-shokax 配套平台：Cloudflare 云端 API + hyc CLI + 管理台/桌面",
  "type": "module",
  "scripts": {
    "lint": "oxlint . --fix",
    "lint:ci": "oxlint .",
    "format": "oxfmt .",
    "format:ci": "oxfmt --check .",
    "typecheck": "oxlint -A all --type-aware --type-check .",
    "typecheck:tsc": "pnpm -r run typecheck:tsc",
    "test": "pnpm -r run test",
    "build": "pnpm --filter \"./packages/*\" --filter \"./apps/console\" run build",
    "check": "pnpm run lint:ci && pnpm run format:ci && pnpm run typecheck && pnpm run test",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --no-frozen-lockfile",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^24.0.0",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.14.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
